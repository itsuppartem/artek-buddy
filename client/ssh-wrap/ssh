#!/usr/bin/env python3
from __future__ import annotations

import os
import sys


real_ssh = os.environ.get("ARTEK_SSH_REAL", "").strip()
control_path = os.environ.get("ARTEK_SSH_CONTROL_PATH", "").strip()
persist = os.environ.get("ARTEK_SSH_PERSIST", "").strip()
if not real_ssh or not control_path or not persist.isdigit():
    raise SystemExit("Artek Buddy SSH mux environment is incomplete")

os.execv(
    real_ssh,
    [
        real_ssh,
        "-o",
        "ControlMaster=auto",
        "-o",
        f"ControlPath={control_path}",
        "-o",
        f"ControlPersist={persist}",
        *sys.argv[1:],
    ],
)
