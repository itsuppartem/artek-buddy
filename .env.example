# Generate: openssl rand -hex 24
AGENT_HTTP_TOKEN=
# AGENT_RUNTIME=cursor
# Optional. Paste a key in Models after pairing, or set this to seed Cursor.
CURSOR_API_KEY=
CURSOR_MODEL=grok-4.6
CURSOR_MODEL_EFFORT=xhigh
CURSOR_MODEL_FAST=true
# Generate: openssl rand -hex 16
MEMORY_DB_PASSWORD=
# DATABASE_URL=postgresql://artek:YOUR_PASSWORD@127.0.0.1:5432/artek_buddy
# Optional. When empty, the supervisor token is derived from AGENT_HTTP_TOKEN
# and is not the same string as the host token.
# SANDBOX_SUPERVISOR_TOKEN=
# SANDBOX_SUPERVISOR_URL=http://127.0.0.1:7091
# SANDBOX_PROVIDER=docker
# COMPUTER_IMAGE=artek-buddy-computer:local
# Unused box sleeps after this many seconds. Heartbeat and an open pane do not refresh it.
# COMPUTER_IDLE_SECONDS=900
# Take control auto-releases after this many seconds with no mouse or key.
# COMPUTER_TAKEOVER_IDLE_SECONDS=120
# Hard Take control cap. Idle release usually happens first.
# COMPUTER_TAKEOVER_TTL_SECONDS=900
# Optional local memory index on loopback. The host still works if it is down.
# MEMORY_GATEWAY_URL=http://127.0.0.1:8420
# Tests / scripted host auto-allow consent. Product Cursor mode always asks.
# CONSENT_AUTO=ask
